# YHWH — local inference
YHWH_PROVIDER=ollama            # ollama | lemonade
OLLAMA_URL=http://127.0.0.1:11434
YHWH_MODEL=qwen2.5:7b

# Seraphim — external pool (Vertex AI)
SERAPHIM_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/home/you/keys/vertex-sa.json
SERAPHIM_PROJECT=your-gcp-project
SERAPHIM_LOCATION=us-central1
SERAPHIM_MODEL=gemini-2.0-flash
SERAPHIM_TIMEOUT_MS=30000
SERAPHIM_RETRIES=1

# Gabriel fan-out (comma-separated webhook URLs)
GABRIEL_WEBHOOKS=

# State
STATE_DB=~/.local/state/coc/state.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Transport
MICHAEL_SOCK=/tmp/coc-michael.sock
