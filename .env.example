# Server
PORT=3000
MICHAEL_SOCK=/tmp/coc-michael.sock

# Security (set in production)
AUTH_TOKEN=
CORS_ORIGIN=

# Persistence (JSON file; leave empty for memory-only)
STATE_DB=./data/state.json
# Load demo seed data (agents always present; messages/canvases/etc. when true)
SEED_DEMO_DATA=false

# LLM backends
YHWH_PROVIDER=
YHWH_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
GEMINI_API_KEY=

# Seraphim (Vertex)
SERAPHIM_ENABLED=false
SERAPHIM_PROJECT=
SERAPHIM_LOCATION=us-central1
SERAPHIM_MODEL=gemini-2.0-flash
SERAPHIM_RETRIES=1
SERAPHIM_TIMEOUT_MS=30000
GOOGLE_APPLICATION_CREDENTIALS=

# Comms
GABRIEL_WEBHOOKS=

# Supabase (RAG / embeddings / stripe edge) — no hardcoded project refs
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_RAG_PATH=/functions/v1/rag-query
SUPABASE_EMBED_PATH=/functions/v1/generate-embedding
SUPABASE_STRIPE_PATH=/functions/v1/stripe-webhook
