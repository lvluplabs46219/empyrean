# Server (local)
PORT=3000
MICHAEL_SOCK=/tmp/coc-michael.sock

# Security
AUTH_TOKEN=
CORS_ORIGIN=

# Persistence
STATE_DB=./data/state.json
SEED_DEMO_DATA=false

# ── Hermes / local Ollama (no Gemini) ───────────────────────
YHWH_MODEL=hermes3:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=60000

# Online Hermes (OpenAI-compatible: Nous Portal, OpenRouter, custom)
# Example OpenRouter: HERMES_BASE_URL=https://openrouter.ai/api/v1
# Example local OpenAI-compat proxy: HERMES_BASE_URL=http://127.0.0.1:11434/v1
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes3:8b

# Seraphim = heavy tier → same Hermes online endpoint
SERAPHIM_ENABLED=true
SERAPHIM_MODEL=hermes3:8b
SERAPHIM_RETRIES=1
SERAPHIM_TIMEOUT_MS=30000

# Comms
GABRIEL_WEBHOOKS=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_RAG_PATH=/functions/v1/rag-query
SUPABASE_EMBED_PATH=/functions/v1/generate-embedding
SUPABASE_STRIPE_PATH=/functions/v1/stripe-webhook
